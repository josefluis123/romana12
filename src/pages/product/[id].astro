---
import Navbar from '../../components/Navbar.astro';
import { ALL_PRODUCTS } from '../../data/products';

export function getStaticPaths() {
  return Object.keys(ALL_PRODUCTS).map(id => ({
    params: { id },
    props: { product: ALL_PRODUCTS[id] }
  }));
}

const { product } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{product.title} - Romana</title>
    <link rel="stylesheet" href="/styles.css" />
    <link href="https://fonts.googleapis.com/css2?family=Koulen&display=swap" rel="stylesheet">
  </head>
  <body>
    <Navbar />
    <main>
      <section class="product-detail">
        <div class="container">
          <!-- Back button -->
          <a href="/products" class="back-link">← Back to Products</a>

          <div class="product-detail-grid">
            <!-- Product Image Column -->
            <div class="product-image-section">
              <img id="main-image" src={product.image} alt={product.title} class="product-main-image" />
              <div class="product-thumbnails">
                <img src={product.image} alt="Thumbnail 1" class="thumbnail active" />
              </div>
            </div>

            <!-- Product Info Column -->
            <div class="product-info-section">
              <!-- Product Title and Rating -->
              <h1 class="product-title">{product.title}</h1>
              <div class="product-rating">
                <span class="stars">★★★★★</span>
                <span class="review-count">({product.reviews} reviews)</span>
              </div>

              <!-- Price -->
              <div class="product-price">
                <span class="price-label">Price:</span>
                <span class="price-value">₱{product.price.toLocaleString()}</span>
              </div>

              <!-- Quick Description -->
              <p class="product-short-desc">
                {product.description}
              </p>

              <!-- Size/Quantity Selection -->
              <div class="product-options">
                <div class="size-selector">
                  <label for="size">Size:</label>
                  <select id="size" name="size">
                    <option value="small">Small (4oz) - ₱499</option>
                    <option value="medium" selected>Medium (8oz) - ₱{product.price.toLocaleString()}</option>
                    <option value="large">Large (16oz) - ₱999</option>
                  </select>
                </div>

                <div class="quantity-selector">
                  <label for="quantity">Quantity:</label>
                  <div class="quantity-control">
                    <button class="qty-btn" id="qty-minus">−</button>
                    <input type="number" id="quantity" name="quantity" value="1" min="1" />
                    <button class="qty-btn" id="qty-plus">+</button>
                  </div>
                </div>
              </div>

              <!-- Add to Cart Button -->
              <button class="btn-add-to-cart">Add to Cart</button>

              <!-- Sharing Options -->
              <div class="sharing-options">
                <p>Share:</p>
                <a href="#" class="share-btn">Facebook</a>
                <a href="#" class="share-btn">Twitter</a>
                <a href="#" class="share-btn">Pinterest</a>
              </div>
            </div>
          </div>

          <!-- Product Details Tabs -->
          <div class="product-details-tabs">
            <div class="tabs-header">
              <button class="tab-btn active" data-tab="description">Description</button>
              <button class="tab-btn" data-tab="ingredients">Ingredients</button>
              <button class="tab-btn" data-tab="nutrition">Nutrition</button>
              <button class="tab-btn" data-tab="reviews">Reviews</button>
            </div>

            <!-- Description Tab -->
            <div class="tab-content active" id="description">
              <h3>About This Product</h3>
              <p>
                {product.details}
              </p>
              <p>
                Made with premium ingredients and traditional methods, our {product.title} represents generations of snacking excellence.
              </p>
            </div>

            <!-- Ingredients Tab -->
            <div class="tab-content" id="ingredients">
              <h3>Ingredients</h3>
              <ul>
                {product.ingredients.map(ingredient => <li>{ingredient}</li>)}
              </ul>
              <p><strong>Allergens:</strong> {product.allergens}</p>
            </div>

            <!-- Nutrition Tab -->
            <div class="tab-content" id="nutrition">
              <h3>Nutrition Facts</h3>
              <div class="nutrition-table">
                <div class="nutrition-row">
                  <span class="nutrition-label">Serving Size:</span>
                  <span class="nutrition-value">1 oz (28g)</span>
                </div>
                <div class="nutrition-row">
                  <span class="nutrition-label">Calories:</span>
                  <span class="nutrition-value">150</span>
                </div>
                <div class="nutrition-row">
                  <span class="nutrition-label">Total Fat:</span>
                  <span class="nutrition-value">8g</span>
                </div>
                <div class="nutrition-row">
                  <span class="nutrition-label">Protein:</span>
                  <span class="nutrition-value">4g</span>
                </div>
                <div class="nutrition-row">
                  <span class="nutrition-label">Carbohydrates:</span>
                  <span class="nutrition-value">16g</span>
                </div>
              </div>
            </div>

            <!-- Reviews Tab -->
            <div class="tab-content" id="reviews">
              <h3>Customer Reviews</h3>
              <div class="reviews-list">
                <div class="review-item">
                  <div class="review-header">
                    <span class="reviewer-name">Maria Santos</span>
                    <span class="review-rating">★★★★★</span>
                  </div>
                  <p class="review-text">
                    "Amazing product! The crunch is perfect and the flavor is authentic. Will definitely order again!"
                  </p>
                </div>
                <div class="review-item">
                  <div class="review-header">
                    <span class="reviewer-name">John Doe</span>
                    <span class="review-rating">★★★★☆</span>
                  </div>
                  <p class="review-text">
                    "Really good quality. Fast shipping too!"
                  </p>
                </div>
              </div>

              <!-- Review Form -->
              <div class="review-form">
                <h4>Leave a Review</h4>
                <form>
                  <div class="form-group">
                    <label for="reviewer-name">Name:</label>
                    <input type="text" id="reviewer-name" name="name" required />
                  </div>
                  <div class="form-group">
                    <label for="reviewer-rating">Rating:</label>
                    <select id="reviewer-rating" name="rating">
                      <option value="5">★★★★★ Excellent</option>
                      <option value="4">★★★★☆ Good</option>
                      <option value="3">★★★☆☆ Average</option>
                      <option value="2">★★☆☆☆ Poor</option>
                      <option value="1">★☆☆☆☆ Terrible</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="reviewer-comment">Review:</label>
                    <textarea id="reviewer-comment" name="comment" rows="5" required></textarea>
                  </div>
                  <button type="submit" class="btn-submit-review">Submit Review</button>
                </form>
              </div>
            </div>
          </div>

          <!-- Related Products -->
          <div class="related-products">
            <h3>Related Products</h3>
            <div class="related-grid">
              <a href="/product/cocoa" class="related-card">
                <img src="/products/r_cocoa.jpeg" alt="Cocoa" />
                <h4>Cocoa</h4>
                <p>₱649</p>
              </a>
              <a href="/product/cashew-adobo" class="related-card">
                <img src="/products/cashew_adobo.jpeg" alt="Cashew Adobo" />
                <h4>Cashew Adobo</h4>
                <p>₱649</p>
              </a>
              <a href="/product/peanut-butter-brittle" class="related-card">
                <img src="/products/peanut_butter_brittle.jpeg" alt="Peanut Butter Brittle" />
                <h4>Peanut Butter Brittle</h4>
                <p>₱649</p>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script>
      // Tab switching functionality
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const tabName = btn.getAttribute('data-tab');
          
          // Remove active from all tabs and contents
          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
          
          // Add active to clicked tab
          btn.classList.add('active');
          document.getElementById(tabName).classList.add('active');
        });
      });

      // Quantity controls
      document.getElementById('qty-minus').addEventListener('click', () => {
        const qty = document.getElementById('quantity');
        if (qty.value > 1) qty.value = parseInt(qty.value) - 1;
      });

      document.getElementById('qty-plus').addEventListener('click', () => {
        const qty = document.getElementById('quantity');
        qty.value = parseInt(qty.value) + 1;
      });

      // Size selector price update
      document.getElementById('size').addEventListener('change', (e) => {
        const prices = {
          small: '₱499',
          medium: '₱649',
          large: '₱999'
        };
        document.querySelector('.price-value').textContent = prices[e.target.value];
      });

      // Add to cart button
      document.querySelector('.btn-add-to-cart').addEventListener('click', () => {
        const size = document.getElementById('size').value;
        const qty = document.getElementById('quantity').value;
        alert(`Added ${qty} item(s) to cart!`);
      });
    </script>
  </body>
</html>

