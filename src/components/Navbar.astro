---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '#contact', label: 'Contact' },
];
---

<nav class="site-nav" role="navigation" aria-label="Main navigation">
  <div class="nav-wrapper">
      <div class="nav-left">
        <a class="logo" href="/">
          <img class="logo-img" src="/logo.png" alt="Romana logo" />
        </a>
      </div>

    <!-- Mobile toggle -->
    <button class="nav-toggle" aria-controls="primary-navigation" aria-expanded="false" aria-label="Toggle navigation">
      <span class="hamburger" aria-hidden></span>
    </button>

    <div class="nav-center">
      <ul id="primary-navigation" class="nav-list">
        {navItems.map(item => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    
  </div>
</nav>

<!-- Navbar stays sticky at top only during hero, fades when scrolling past -->
<script>
  (function(){
    try{
      const nav = document.querySelector('.site-nav');
      if (!nav) return;

      // Only show nav while hero is visible
      window.addEventListener('scroll', function(){
        const hero = document.querySelector('.hero-split');
        if (!hero) return;

        const heroRect = hero.getBoundingClientRect();
        // If hero bottom is still visible, keep nav visible (opacity 1)
        // Otherwise, fade it out (opacity 0)
        if (heroRect.bottom > 0) {
          nav.style.opacity = '1';
          nav.style.pointerEvents = 'auto';
        } else {
          nav.style.opacity = '0';
          nav.style.pointerEvents = 'none';
        }
      }, { passive: true });

      // Initial check on load
      const hero = document.querySelector('.hero-split');
      if (hero) {
        const heroRect = hero.getBoundingClientRect();
        nav.style.opacity = heroRect.bottom > 0 ? '1' : '0';
        nav.style.pointerEvents = heroRect.bottom > 0 ? 'auto' : 'none';
      }
    }catch(e){/* silent */}
  })();
</script>

<!-- Mobile menu toggle -->
<script>
  (function(){
    try{
      const btn = document.querySelector('.nav-toggle');
      const wrapper = document.querySelector('.nav-wrapper');
      const nav = document.getElementById('primary-navigation');
      if (!btn || !wrapper) return;
      btn.addEventListener('click', function(){
        const isOpen = wrapper.classList.toggle('open');
        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (nav) nav.setAttribute('data-open', isOpen ? 'true' : 'false');
      });
    }catch(e){/* silent */}
  })();
</script>
