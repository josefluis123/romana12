---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '#products', label: 'Products' },
  { href: '#contact', label: 'Contact' },
];
---

<nav class="site-nav" role="navigation" aria-label="Main navigation">
  <div class="nav-wrapper">
      <div class="nav-left">
        <a class="logo" href="/">
          <img class="logo-img" src="/logo.png" alt="Romana logo" />
        </a>
      </div>

    <!-- Mobile toggle -->
    <button class="nav-toggle" aria-controls="primary-navigation" aria-expanded="false" aria-label="Toggle navigation">
      <span class="hamburger" aria-hidden></span>
    </button>

    <div class="nav-center">
      <ul id="primary-navigation" class="nav-list">
        {navItems.map(item => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    
  </div>
</nav>

<!-- Small client-side script to toggle mobile menu -->
<script>
  (function(){
    try{
      const btn = document.querySelector('.nav-toggle');
      const wrapper = document.querySelector('.nav-wrapper');
      const nav = document.getElementById('primary-navigation');
      if (!btn || !wrapper) return;
      btn.addEventListener('click', function(){
        const isOpen = wrapper.classList.toggle('open');
        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (nav) nav.setAttribute('data-open', isOpen ? 'true' : 'false');
      });
    }catch(e){/* silent */}
  })();
</script>

<!-- Auto-hide navbar when pointer is idle -->
<script>
  (function(){
    try{
      const nav = document.querySelector('.site-nav');
      if (!nav) return;
      let idleTimer = null;
      const IDLE_MS = 3000; // 3 seconds

      function hideNav(){
        nav.classList.add('nav-hidden');
      }
      function showNav(){
        nav.classList.remove('nav-hidden');
      }

      function resetTimer(){
        // do not hide when mobile menu is open
        const wrapper = document.querySelector('.nav-wrapper');
        if (wrapper && wrapper.classList.contains('open')) {
          showNav();
          if (idleTimer) clearTimeout(idleTimer);
          return;
        }
        showNav();
        if (idleTimer) clearTimeout(idleTimer);
        idleTimer = setTimeout(hideNav, IDLE_MS);
      }

      // listen for pointer activity (covers mouse, touch, stylus)
      ['pointermove','pointerdown','pointerup','mousemove','touchstart'].forEach(ev => {
        window.addEventListener(ev, resetTimer, { passive: true });
      });

      // reveal nav on scroll as well (user expectation)
      window.addEventListener('scroll', function(){
        showNav();
        resetTimer();
      }, { passive: true });

      // start the timer on load
      resetTimer();
    }catch(e){/* silent */}
  })();
</script>
