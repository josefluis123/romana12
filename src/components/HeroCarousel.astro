---
// Static hero section with background image
const backgroundImage = '/background.jpeg';
const title = 'The Origina Philippine Peanut Brittle';
const subtitle = 'Classic recipe since 1956.';
---

<section class="hero-split" aria-label="Hero section" style={`background-image: url('${backgroundImage}'); background-size: cover; background-position: center;`}>
  <div class="hero-text">
    <h1 class="hero-title">{title.replace(/\n/g, '<br/>')}</h1>
    <p class="hero-sub">{subtitle}</p>
  </div>

  <script>
    // Scroll-driven fade effect for hero section
    document.addEventListener('DOMContentLoaded', () => {
      const hero = document.querySelector('.hero-split');
      const story = document.querySelector('.our-story');
      if (!hero || !story) return;

      // Helper: easeOutCubic for natural feeling
      function ease(t){ return 1 - Math.pow(1 - t, 3); }

      let ticking = false;
      function update(){
        ticking = false;
        // viewport metrics
        const vh = window.innerHeight || document.documentElement.clientHeight;

        // compute distance between hero bottom and story top
        const heroRect = hero.getBoundingClientRect();
        const storyRect = story.getBoundingClientRect();

        // Start transition when story top enters bottom half of viewport
        const start = vh * 0.55; // when story.top <= start, begin
        const end = vh * 0.15;   // when story.top <= end, finish

        let raw = (start - storyRect.top) / (start - end);
        raw = Math.max(0, Math.min(1, raw));
        const eased = ease(raw);

        // update CSS variables (0..1) - only hero is affected, not our-story
        hero.style.setProperty('--hero-progress', String(eased));
      }

      function onScroll(){ if (!ticking) { ticking = true; requestAnimationFrame(update); } }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      // initial update
      requestAnimationFrame(update);
    });
  </script>
</section>